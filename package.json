{
  "name": "pi-xray",
  "version": "0.1.0",
  "description": "See what fills your pi context window, which package each piece comes from, and turn skills, extensions and prompts on or off from one view.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "pi-coding-agent",
    "context-window",
    "tokens",
    "skills",
    "packages",
    "mcp"
  ],
  "license": "MIT",
  "author": "Daniel Enriquez (https://github.com/daniel-enqz)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daniel-enqz/pi-xray.git"
  },
  "homepage": "https://github.com/daniel-enqz/pi-xray#readme",
  "bugs": {
    "url": "https://github.com/daniel-enqz/pi-xray/issues"
  },
  "files": [
    "src",
    "README.md",
    "DESIGN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/daniel-enqz/pi-xray/main/docs/demo.gif"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.2.0"
  },
  "scripts": {
    "test": "node test/run.mjs"
  },
  "engines": {
    "node": ">=20.6"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
